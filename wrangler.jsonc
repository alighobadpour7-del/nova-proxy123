{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy123",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "db570e7c-b3a0-4b16-8109-febeada5edfd","database_name": "nova-proxy-alighobadpour7" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "25dac59e1fe146f0a60007f1dc44a095" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
